# ============================================================
#  Jarvis – Konfiguration  (kopieren nach .env und ausfüllen)
# ============================================================

# --- Claude-Abo (KEIN API-Key!) ------------------------------
# Einmalig am Rechner `claude setup-token` ausführen (Pro/Max-Login) und den
# Token hier eintragen. Alternativ auf dem Server einmal `claude` starten und /login.
CLAUDE_CODE_OAUTH_TOKEN=
# Leer lassen = Standardmodell deines Abos. Z.B. "sonnet" spart Kontingent.
CLAUDE_MODEL=
# ANTHROPIC_API_KEY wird von Jarvis absichtlich ignoriert (sonst API-Kosten).

# --- Du ------------------------------------------------------
JARVIS_USER_NAME=Robin
JARVIS_TIMEZONE=Europe/Berlin
JARVIS_LANGUAGE=de

# --- Web-App / API -------------------------------------------
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8080
# Langes zufälliges Passwort. Leer = wird automatisch erzeugt (`jarvis token`).
JARVIS_TOKEN=

# --- Telegram (Sprachnachrichten vom Handy) -------------------
# Bot bei @BotFather anlegen → Token hier eintragen.
TELEGRAM_BOT_TOKEN=
# Deine Telegram-User-ID (dem Bot /id schreiben). Mehrere kommagetrennt.
TELEGRAM_ALLOWED_USER_IDS=
# Auf Sprachnachrichten auch per Sprache antworten (braucht Piper + ffmpeg)
TELEGRAM_VOICE_REPLY=true

# --- Google (Gmail + Kalender) --------------------------------
GOOGLE_ENABLED=true
# false = Jarvis erstellt nur Entwürfe, senden machst du selbst in Gmail (empfohlen zum Start)
JARVIS_ALLOW_SEND_EMAIL=false

# --- Sprache (lokal & kostenlos) ------------------------------
# tiny | base | small | medium | large-v3   (small ist ein guter Kompromiss für CPU)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# Pfad zu einer Piper-Stimme, z.B. models/de_DE-thorsten-high.onnx (optional)
PIPER_VOICE=

# --- Routinen (verbrauchen Abo-Kontingent!) -------------------
# Morgen-Briefing per Telegram/ntfy, leer = aus
JARVIS_BRIEFING_TIME=07:30
# Posteingang alle N Minuten auf Wichtiges prüfen, 0 = aus
JARVIS_INBOX_CHECK_MINUTES=0
# In diesen Stunden keine Mail-Checks
JARVIS_QUIET_HOURS=22-7
# Optional: Push über ntfy-App statt/zusätzlich zu Telegram
NTFY_URL=

# Weitere Claude-Code-Tools freischalten (Vorsicht!), z.B. Bash(ls *)
JARVIS_EXTRA_TOOLS=
