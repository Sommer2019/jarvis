# ============================================================
#  Jarvis – Konfiguration  (kopieren nach .env und ausfüllen)
# ============================================================

# --- Claude-Abo (KEIN API-Key!) ------------------------------
# Einmalig am Rechner `claude setup-token` ausführen (Pro/Max-Login) und den
# Token hier eintragen. Alternativ auf dem Server einmal `claude` starten und /login.
CLAUDE_CODE_OAUTH_TOKEN=
# Leer lassen = Standardmodell deines Abos. Z.B. "sonnet" spart Kontingent.
CLAUDE_MODEL=
# ANTHROPIC_API_KEY wird von Jarvis absichtlich ignoriert (sonst API-Kosten).

# --- Du ------------------------------------------------------
JARVIS_USER_NAME=Robin
JARVIS_TIMEZONE=Europe/Berlin
JARVIS_LANGUAGE=de

# --- Web-App / API -------------------------------------------
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8080
# Langes zufälliges Passwort. Leer = wird automatisch erzeugt (`jarvis token`).
JARVIS_TOKEN=

# --- Telegram (Sprachnachrichten vom Handy) -------------------
# Bot bei @BotFather anlegen → Token hier eintragen.
TELEGRAM_BOT_TOKEN=
# Deine Telegram-User-ID (dem Bot /id schreiben). Mehrere kommagetrennt.
TELEGRAM_ALLOWED_USER_IDS=
# Auf Sprachnachrichten auch per Sprache antworten (braucht Piper + ffmpeg)
TELEGRAM_VOICE_REPLY=true

# --- Google (Gmail + Kalender) --------------------------------
GOOGLE_ENABLED=true
# false = Jarvis erstellt nur Entwürfe, senden machst du selbst in Gmail (empfohlen zum Start)
JARVIS_ALLOW_SEND_EMAIL=false

# --- E-Mail bei jedem Anbieter (IMAP/SMTP) -------------------
# Beispiele: GMX imap.gmx.net / mail.gmx.net:587 · Web.de imap.web.de / smtp.web.de:587
# Outlook outlook.office365.com / smtp.office365.com:587 · iCloud imap.mail.me.com / smtp.mail.me.com:587
# T-Online secureimap.t-online.de / securesmtp.t-online.de:465 · Posteo posteo.de / posteo.de:465
# Weitere Konten: data/mail_accounts.json (siehe README)
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
SMTP_HOST=
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_ACCOUNT_NAME=privat

# --- CalDAV / CardDAV (Nextcloud, iCloud, mailbox.org, Posteo, Fastmail …) ---
# Es reicht meist die Basis-URL, Kalender/Adressbücher werden automatisch gefunden.
# Nextcloud: https://cloud.example.de/remote.php/dav
# iCloud:    https://caldav.icloud.com  bzw.  https://contacts.icloud.com  (App-spezifisches Passwort!)
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Standard-Kalender für neue Termine (Name), leer = erster
CALDAV_DEFAULT_CALENDAR=
CARDDAV_URL=
# leer = gleiche Zugangsdaten wie CalDAV
CARDDAV_USERNAME=
CARDDAV_PASSWORD=

# --- Handy-App ---------------------------------------------
# auto = Handy-Tools (Kontakte, Anrufen, Wecker …) aktiv, sobald die Android-App verbunden war
JARVIS_PHONE=auto

# --- WhatsApp (offizielle Cloud API von Meta, siehe README) --
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# frei wählbar, muss im Meta-Webhook identisch eingetragen werden
WHATSAPP_VERIFY_TOKEN=
# App-Secret (Meta → App-Einstellungen → Allgemein) zur Signaturprüfung
WHATSAPP_APP_SECRET=
# deine eigene Handynummer(n), international ohne +, kommagetrennt, z.B. 491701234567
WHATSAPP_ALLOWED_NUMBERS=
# auf Sprachnachrichten auch per Sprache antworten (Piper + ffmpeg)
WHATSAPP_VOICE_REPLY=false

# --- Sprache (lokal & kostenlos) ------------------------------
# tiny | base | small | medium | large-v3   (small ist ein guter Kompromiss für CPU)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# Pfad zu einer Piper-Stimme, z.B. models/de_DE-thorsten-high.onnx (optional)
PIPER_VOICE=

# --- Routinen (verbrauchen Abo-Kontingent!) -------------------
# Morgen-Briefing per Telegram/ntfy, leer = aus
JARVIS_BRIEFING_TIME=07:30
# Posteingang alle N Minuten auf Wichtiges prüfen, 0 = aus
JARVIS_INBOX_CHECK_MINUTES=0
# In diesen Stunden keine Mail-Checks
JARVIS_QUIET_HOURS=22-7
# Optional: Push über ntfy-App statt/zusätzlich zu Telegram
NTFY_URL=

# Weitere Claude-Code-Tools freischalten (Vorsicht!), z.B. Bash(ls *)
JARVIS_EXTRA_TOOLS=
